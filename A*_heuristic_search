import heapq

# Graph
graph = {
    'P': {'Q': 1, 'R': 4},
    'Q': {'R': 2, 'G': 5, 'T': 12},
    'R': {'G': 2},
    'G': {'T': 3},
    'T': {}
}

# Heuristic values
h = {
    'P': 7,
    'Q': 6,
    'R': 2,
    'G': 1,
    'T': 0
}


def a_star(start, goal):

    # (f, g, node, path)
    open_list = [(h[start], 0, start, [start])]

    # Best known cost
    g_cost = {start: 0}

    while open_list:

        f, g, current, path = heapq.heappop(open_list)

        # Ignore outdated entry
        if g > g_cost.get(current, float('inf')):
            continue

        print(f"Expanding {current}: g={g}, h={h[current]}, f={f}")

        # Goal reached
        if current == goal:
            return path, g

        # Explore neighbors
        for neighbor, edge_cost in graph[current].items():

            new_g = g + edge_cost

            # If a better path is found
            if new_g < g_cost.get(neighbor, float('inf')):

                g_cost[neighbor] = new_g

                new_f = new_g + h[neighbor]

                heapq.heappush(
                    open_list,
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    return None, float('inf')


# Start and Goal
start = 'P'
goal = 'T'

path, cost = a_star(start, goal)

print("\nOptimal Path:", " -> ".join(path))
print("Minimum Cost:", cost)
