import heapq

# Start state
start = (
    7, 2, 4,
    5, 0, 6,
    8, 3, 1
)

# Goal state
goal = (
    0, 1, 2,
    3, 4, 5,
    6, 7, 8
)


# Manhattan Distance Heuristic
def heuristic(state):
    distance = 0

    for i in range(9):
        if state[i] == 0:
            continue

        # Current position
        x1 = i // 3
        y1 = i % 3

        # Goal position
        goal_index = goal.index(state[i])
        x2 = goal_index // 3
        y2 = goal_index % 3

        distance += abs(x1 - x2) + abs(y1 - y2)

    return distance


# Generate possible moves
def get_neighbors(state):

    neighbors = []

    blank = state.index(0)

    row = blank // 3
    col = blank % 3

    moves = [
        (-1, 0, "Up"),
        (1, 0, "Down"),
        (0, -1, "Left"),
        (0, 1, "Right")
    ]

    for dr, dc, move in moves:

        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:

            new_blank = new_row * 3 + new_col

            new_state = list(state)

            # Swap blank with tile
            new_state[blank], new_state[new_blank] = \
                new_state[new_blank], new_state[blank]

            neighbors.append((tuple(new_state), move))

    return neighbors


# Print puzzle
def print_puzzle(state):

    for i in range(0, 9, 3):
        print(state[i:i+3])

    print()


# A* Search
def a_star(start):

    # Priority queue
    # (f, g, state, path)
    pq = []

    g = 0
    h = heuristic(start)
    f = g + h

    heapq.heappush(pq, (f, g, start, []))

    visited = set()

    while pq:

        f, g, state, path = heapq.heappop(pq)

        if state in visited:
            continue

        visited.add(state)

        # Goal reached
        if state == goal:
            return path, g

        # Generate next states
        for next_state, move in get_neighbors(state):

            if next_state not in visited:

                new_g = g + 1
                new_h = heuristic(next_state)
                new_f = new_g + new_h

                heapq.heappush(
                    pq,
                    (new_f, new_g, next_state, path + [move])
                )

    return None, None


# Run A*
path, cost = a_star(start)


# Display result
print("Start State:")
print_puzzle(start)

print("Goal State:")
print_puzzle(goal)

print("Solution:")
print(path)

print("\nTotal Moves:", cost)

print("\nNumber of moves:", len(path))
